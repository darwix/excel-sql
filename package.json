{
  "name": "converter",
  "private": true,
  "scripts": {
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "simple-git-hooks": "^2.11.0"
  }
}
